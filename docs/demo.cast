[0.012146, "o", "\r\n$ secret-guard install-hook\r\n"]
[1.186328, "o", "Hook dipasang: /tmp/demo-sg.hNb26o/.git/hooks/pre-commit\r\n"]
[2.210752, "o", "\r\n$ echo 'aws_key = \"<kunci>\"' > config.py && git add config.py\r\n"]
[4.226458, "o", "\r\n$ git commit -m 'tambah konfigurasi'\r\n"]
[5.387474, "o", "\u001b[1;31msecret-guard:\u001b[0m 1 kemungkinan secret ditemukan\r\n"]
[5.387677, "o", "\r\n"]
[5.388001, "o", "\u001b[1mconfig.py\u001b[0m\r\n"]
[5.388332, "o", "  baris 1     \u001b[33maws-access-key-id    \u001b[0m\u001b[2mAKIA****\u001b[0m\r\n"]
[5.388534, "o", "\r\n"]
[5.388836, "o", "\u001b[1mCara menangani:\u001b[0m\r\n"]
[5.388983, "o", "  - Hapus secret dari file, lalu git add lagi. Kalau sudah pernah ter-commit\r\n"]
[5.389179, "o", "    atau ter-push, anggap sudah bocor dan ganti (rotate) kuncinya.\r\n"]
[5.389365, "o", "  - False positive: tambahkan '# secret-guard:ignore' di baris itu,\r\n"]
[5.389548, "o", "    atau pola path di .secretguardignore.\r\n"]
[5.389703, "o", "  - Lewati sekali (tidak disarankan): git commit --no-verify\r\n"]
[5.412353, "o", "(kode keluar: 1)\r\n"]
[7.41386, "o", "\r\n$ git rm --cached config.py && echo 'print(1)' > app.py && git add app.py\r\n"]
[9.449335, "o", "\r\n$ git commit -m 'tambah app'\r\n"]
[10.632474, "o", "(kode keluar: 0)\r\n"]
